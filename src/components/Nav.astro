---
/**
 * The nav. Links split left and right, the logo alone in the middle.
 * The logo is the supplied file with only its paper background removed, so it can sit on a hero image. Never redrawn or recolored.
 */
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const left = [
  { href: '/films', label: 'Films' },
  { href: '/music', label: 'Music' },
];

const right = [
  { href: '/honors', label: 'Honors' },
  { href: '/studio', label: 'Studio' },
];

const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="nav">
  <div class="wrap nav-inner">
    <nav class="nav-left" aria-label="Catalog">
      {
        left.map((l) => (
          <a
            href={l.href}
            class:list={['label', { active: isActive(l.href) }]}
            aria-current={isActive(l.href) ? 'page' : undefined}
          >
            {l.label}
          </a>
        ))
      }
    </nav>
    <a href="/" class="mark" aria-label="Wise Owl. Back to the index.">
      <img src="/owl-head-o_red-velvet_clear.svg" alt="" width="120" height="120" />
    </a>
    <nav class="nav-right" aria-label="Studio">
      {
        right.map((l) => (
          <a
            href={l.href}
            class:list={['label', { active: isActive(l.href) }]}
            aria-current={isActive(l.href) ? 'page' : undefined}
          >
            {l.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script>
  // On hero pages the nav sits on the image; it turns solid once the image is out from under it.
  const nav = document.querySelector<HTMLElement>('.nav');
  const hero = document.querySelector('.has-hero .hero, .has-hero .band');
  if (nav && hero) {
    new IntersectionObserver(([entry]) => nav.classList.toggle('solid', !entry.isIntersecting), {
      rootMargin: `-${nav.offsetHeight}px 0px 0px 0px`,
    }).observe(hero);
  }
</script>
