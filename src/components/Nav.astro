---
/**
 * The nav. Links split left and right, the logo alone in the middle.
 * The logo file is used exactly as supplied, never redrawn or recolored.
 */
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const left = [
  { href: '/films', label: 'Films' },
  { href: '/music', label: 'Music' },
];

const right = [
  { href: '/honors', label: 'Honors' },
  { href: '/studio', label: 'Studio' },
];

const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="nav">
  <div class="wrap nav-inner">
    <nav class="nav-left" aria-label="Catalog">
      {
        left.map((l) => (
          <a
            href={l.href}
            class:list={['label', { active: isActive(l.href) }]}
            aria-current={isActive(l.href) ? 'page' : undefined}
          >
            {l.label}
          </a>
        ))
      }
    </nav>
    <a href="/" class="mark" aria-label="Wise Owl. Back to the index.">
      <img src="/owl-head-o_red-velvet.svg" alt="" width="120" height="120" />
    </a>
    <nav class="nav-right" aria-label="Studio">
      {
        right.map((l) => (
          <a
            href={l.href}
            class:list={['label', { active: isActive(l.href) }]}
            aria-current={isActive(l.href) ? 'page' : undefined}
          >
            {l.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
